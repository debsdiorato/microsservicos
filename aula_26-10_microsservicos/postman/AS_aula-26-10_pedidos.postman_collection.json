        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"Ana Souza\",\n  \"email\": \"ana.souza@example.com\",\n  \"valor_total\": 300\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 202 Accepted', () => pm.response.to.have.status(202));",
              "const j = pm.response.json();",
              "pm.test('RECEBIDO e id UUID', () => {",
              "  pm.expect(j.status).to.eql('RECEBIDO');",
              "  pm.expect(j.id).to.match(/^[0-9a-f-]{36}$/);",
              "});",
              "pm.test('resposta em menos de 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));",
              "pm.collectionVariables.set('pedido_id', j.id);"
            ]
          }
        }
      ]
    },
