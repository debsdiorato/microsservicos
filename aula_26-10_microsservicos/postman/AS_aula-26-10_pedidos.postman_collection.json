    {
      "name": "Ex2 - Publicar mensagem malformada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{rabbit_url}}/api/exchanges/%2F/amq.default/publish",
          "host": [
            "{{rabbit_url}}"
          ],
          "path": [
            "api",
            "exchanges",
            "%2F",
            "amq.default",
            "publish"
          ]
        },
        "description": "Publica direto na fila pedido.criado pela exchange padrão. O worker rejeita (nack sem requeue) e a mensagem vai para a DLQ.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"properties\": {\n    \"content_type\": \"application/json\"\n  },\n  \"routing_key\": \"pedido.criado\",\n  \"payload\": \"isto não é JSON {\",\n  \"payload_encoding\": \"string\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{rabbit_user}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{rabbit_pass}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('mensagem roteada para pedido.criado', () => pm.expect(pm.response.json().routed).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ex2 - Ler a DLQ (pedidos.dlq)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{rabbit_url}}/api/queues/%2F/pedidos.dlq/get",
          "host": [
            "{{rabbit_url}}"
          ],
          "path": [
            "api",
            "queues",
            "%2F",
            "pedidos.dlq",
            "get"
          ]
        },
        "description": "ackmode ack_requeue_true: apenas lê, a mensagem continua na DLQ.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"count\": 50,\n  \"ackmode\": \"ack_requeue_true\",\n  \"encoding\": \"auto\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{rabbit_user}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{rabbit_pass}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// espera o worker rejeitar a mensagem",
              "setTimeout(() => {}, 2000);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const msgs = pm.response.json();",
              "pm.test('DLQ contém a mensagem malformada', () => pm.expect(msgs.map(m => m.payload)).to.include('isto não é JSON {'));",
              "pm.test('x-death indica a fila de origem e o motivo', () => {",
              "  const m = msgs.find(m => m.payload === 'isto não é JSON {');",
              "  const d = m.properties.headers['x-death'][0];",
              "  pm.expect(d.queue).to.eql('pedido.criado');",
              "  pm.expect(d.reason).to.eql('rejected');",
              "});"
            ]
          }
        }
      ]
    }
  ],
