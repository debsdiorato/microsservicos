    {
      "name": "GET RabbitMQ /api/queues (pedido.criado)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{rabbit_url}}/api/queues/%2F/pedido.criado",
          "host": [
            "{{rabbit_url}}"
          ],
          "path": [
            "api",
            "queues",
            "%2F",
            "pedido.criado"
          ]
        },
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{rabbit_user}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{rabbit_pass}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const q = pm.response.json();",
              "pm.test('fila durável', () => pm.expect(q.durable).to.eql(true));",
              "pm.test('Ex2 - fila tem dead-letter exchange', () => pm.expect(q.arguments['x-dead-letter-exchange']).to.eql('pedidos.dlx'));",
              "console.log(`Ready: ${q.messages_ready} | Unacked: ${q.messages_unacknowledged}`);"
            ]
          }
        }
      ]
    },
